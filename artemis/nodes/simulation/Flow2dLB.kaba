use artemis.*
#use artemis.profiler.*
use fem.material.*
use yrenderer.gfx

let NK = 9

#let h = 1.0

#let TAU = 0.6

#let CYLINDER_R = 20.0
#let CYLINDER_X = NX / 3
#let CYLINDER_Y = NY / 2

let RDX = [0,0,1,1,1,0,-1,-1,-1]
let RDY = [0,1,1,0,-1,-1,-1,0,1]
let WEIGHTS = [4.0/9, 1.0/9, 1.0/36, 1.0/9, 1.0/36, 1.0/9, 1.0/36, 1.0/9, 1.0/36]

#func swap(out a: f32, out b: f32)
#	let x = a
#	a = b
#	b = x

func swap(out f: MultiField, i: i32, n1: i32, n2: i32)
	let x = f.value(i, n1)
	let y = f.value(i, n2)
	f.set(i, n1, y)
	f.set(i, n2, x)


func get_rho(f: MultiField) -> ScalarField
	var r = Ret.create(f.grid, f32, f.sampling_mode)
	let N = f.grid.count(f.sampling_mode)
	for i in 0:N
		var rr = 0.0 as f64
		for k in 0:NK
			rr += f.value(i, k)
		r.set(i, rr)
	return r


func get_velocity(f: MultiField, rho: ScalarField) -> VectorField
	var u = Ret.create(f.grid, f32, f.sampling_mode)
	let N = u.grid.count(u.sampling_mode)
	for i in 0:N
		# (mean) velocity
		var _u = vec3.0
		for k in 0:NK
			let ff = f.value(i, k) as f32
			_u.x += ff * RDX[k]
			_u.y += ff * RDY[k]
		u.set(i, _u / rho.value(i) as f32)
	return u


func equilibrium(u: VectorField, rho: ScalarField) -> MultiField
	var f = Ret.create(u.grid, f32, u.sampling_mode, NK)
	let N = u.grid.count(u.sampling_mode)
	for i in 0:N
		let _rho = rho.value(i) as f32
		let _u = u.value(i)
		let uu = vec3.dot(_u, _u)
		for k in 0:NK
			let uv = vec3.dot(_u, vec3(RDX[k], RDY[k], 0))
			f.set(i, k, _rho * WEIGHTS[k] * (1 + 3*uv + 4.5*(uv^2) - 1.5*uu))
	return f


func drifted(f: MultiField) -> MultiField
	var r = Ret.create(f.grid, f32, f.sampling_mode, NK)
	#let N = f.grid.count(u.sampling_mode)
	let NX = f.grid.nx
	let NY = f.grid.ny
	for i in 0:NX
		for j in 0:NY
			for k in 0:NK
				var ii = (i + RDX[k])
				if ii < 0
					ii += NX
				else if ii >= NX
					ii -= NX
				var jj = (j + RDY[k])
				if jj < 0
					jj += NY
				else if jj >= NY
					jj -= NY
				r._set(ii, jj, 0, k, f._value(i, j, 0, k))
	return r


func apply_obstacle(out f: MultiField, o: ScalarField)
	for i in 0:f.grid.count(f.sampling_mode)
		if o.value(i) > 0.5
			swap(f, i, 1, 5)
			swap(f, i, 2, 6)
			swap(f, i, 3, 7)
			swap(f, i, 4, 8)


func apply_boundary(out f: MultiField, state0: MultiField, D: i32)
	let NX = f.grid.nx
	let NY = f.grid.ny
	for i in 0:NX
		for j in 0:NY
			let d = min(min(i, j), min(NX-i-1, NY-j-1))
			if d > D
				continue
			let t = exp(-f64(d) / D)
			for k in 0:NK
				f._set(i, j, 0, k, (1-t) * f._value(i, j, 0, k) + t * state0._value(i, j, 0, k))


class Flow2dLB extends Node
	var in_rho = InPort[ScalarField](self, "rho", PortFlags.MUTABLE)
	var in_u = InPort[VectorField](self, "u", PortFlags.MUTABLE)
	var in_obs = InPort[ScalarField](self, "obstacle", PortFlags.OPTIONAL)
	var tau = Setting[f64](self, "tau", 0.5)

	var c1, c2, c3, c4, c5, c6, c7: i32

	var state: MultiField
	var state0: MultiField

#	var buffer: owned[gfx.ShaderStorageBuffer]


	func __init__()
		super.__init__("Flow2dLB")
		flags = NodeFlags.TIME_DEPENDENT
		c1 = profiler.create_channel("drift", channel)
		c2 = profiler.create_channel("rho", channel)
		c3 = profiler.create_channel("v", channel)
		c4 = profiler.create_channel("eq", channel)
		c5 = profiler.create_channel("eq'", channel)
		c6 = profiler.create_channel("bnd", channel)
		c7 = profiler.create_channel("x", channel)


	func override on_process()
		# assume PER_CELL
		for mut rho in in_rho.value(), mut u in in_u.value()

			#let dt = current_session().graph.dt

			if rho.grid != state.grid
				state0 = equilibrium(u, rho)
				state = state0

			#	buffer = new gfx.ShaderStorageBuffer(f.grid.count(f.sampling_mode) * sizeof(f32) * NK)

			profiler.begin(c1)
			state = drifted(state)
			profiler.end(c1)

			profiler.begin(c2)
			rho = get_rho(state)
			profiler.end(c2)
			profiler.begin(c3)
			u = get_velocity(state, rho)
			profiler.end(c3)

			profiler.begin(c4)
			let eq = equilibrium(u, rho)
			profiler.end(c4)
			profiler.begin(c5)
			state += (eq - state) * (1.0/tau())
			profiler.end(c5)

			profiler.begin(c6)
			for obstacle in in_obs.value()
				apply_obstacle(state, obstacle)

			apply_boundary(state, state0, 3)
			profiler.end(c6)

			profiler.begin(c7)
		#	f.begin_edit_gpu()
		#	f.begin_edit_cpu()
			profiler.end(c7)


			in_rho.mutated()
			in_u.mutated()

