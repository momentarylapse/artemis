use artemis.graph.*
use artemis.grid.*
use artemis.session.*
use artemis.data.*
use artemis.fields
use kaba

class ScalarField extends Node
	var in_grid = InPort[Grid](self, "grid")
	var out_field = OutPort[fields.ScalarField](self, "out")
	var formula = Setting[string](self, "formula", "sin(x)")
	var type = Setting[fields.ScalarType](self, "type", fields.ScalarType.F32)
	var sampling_mode = Setting[SamplingMode](self, "sampling-mode", SamplingMode.PER_CELL)
	var time_dependent = Setting[bool](self, "time-dependent", false)

	var cached_formula: string
	var ctx: owned[kaba.Context]
	var module: shared[kaba.Module]
	var f: kaba.code* = nil #(vec3, f32) -> f32


	func __init__()
		super.__init__("ScalarField")
		time_dependent.on_update(on_update_time_dependent)


	func mut on_update_time_dependent()
		print("update")
		flags = if time_dependent()
			NodeFlags.RESOURCE | NodeFlags.TIME_DEPENDENT
		else
			NodeFlags.RESOURCE


	func override on_process()
		for g in in_grid.value()
			if formula() != cached_formula or !f
				cached_formula = formula()
				#ctx = kaba.default_context.create_new_context()
				ctx = kaba.Context.create()

				let source = "
func f(p: vec3, t: f32) -> f32
	let x = p.x
	let y = p.y
	let z = p.z
	return {{formula()}}"

				try
					module = ctx!.create_module_for_source(source, "<temp>")!
					f = module!.match_function("f", f32, [vec3, f32])!
				except Error as e
					error(str(e))

			for ff in  f
				let t = current_session().t as f32
				let rg = g.regular!
				var s = fields.ScalarField.create(rg, fields.decode_scalar_type(type()),
					sampling_mode())

				for i=>p in g.points(sampling_mode())
					s.set(i, eval_vec3_f32_f32(&ff, p, t) as f64)

				out_field.set(s)
