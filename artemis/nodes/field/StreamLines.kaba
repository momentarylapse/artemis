use artemis.*
use yrenderer
use yrenderer.gfx
use simplevis as sv


class StreamLines extends Node
	var in_field = InPort[VectorField](self, "field")
	var out_lines = OutPort[vec3[][]](self, "lines")
	var count = Setting[i32](self, "count", 100)
	var length = Setting[i32](self, "length", 30)


	func __init__()
		super.__init__("StreamLines")


	func override mut on_process()
		for f in in_field.value()
			var lines: vec3[][]
			let g = f.grid
			for i in 0:count()
				var points: vec3[]
				var p = vec3(rand(g.nx as f32), rand(g.ny as f32), rand(g.nz as f32))
				for k in 0:length()
					points.add(g.to_absolute(p))
					let v = f.value(g.closest_index(p, f.sampling_mode))
					if len(v) < 0.6
						break
					let dt = 0.7
					p += v.normalized() * dt
					if p.x < 0 or p.y < 0 or p.z < 0 or p.x > g.nx or p.y > g.ny or p.z > g.nz
						break
				lines.add(points)
			out_lines.set(lines)


