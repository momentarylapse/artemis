
enum extern SamplingMode
	PER_CELL
	PER_VERTEX
	PER_EDGE


enum extern GridType
	NONE
	REGULAR
	UNSTRUCTURED


struct extern RegularGrid
	func extern __init__()
	var nx, ny, nz: i32
	var dx, dy, dz: vec3
	var offset: vec3
	func extern __eq__(o: Self) -> bool
	func extern __neq__(o: Self) -> bool
	func extern vertices() -> vec3[]
	func extern vertex(i: i32, j: i32, k: i32) -> vec3
	func extern cell_centers() -> vec3[]
	func extern cell_center(i: i32, j: i32, k: i32) -> vec3
	func extern points(mode: SamplingMode) -> vec3[]
	func extern edges() -> (i32,i32)[]
	func extern count(mode: SamplingMode) -> i32
	func extern bounding_box() -> Box
	func extern cell_index(i: i32, j: i32, k: i32) -> i32
	func extern vertex_index(i: i32, j: i32, k: i32) -> i32
	func extern sample_index(i: i32, j: i32, k: i32, mode: SamplingMode) -> i32
	func to_grid() -> Grid
		var r: Grid
		r.type = GridType.REGULAR
		r.regular = self
		return r
	func to_absolute(p: vec3) -> vec3
		return offset + dx*p.x + dy*p.y + dz*p.z
	# p relative!
	func closest_index(p: vec3, mode: SamplingMode) -> i32
		return match mode
			SamplingMode.PER_CELL => cell_index(clamp(i32(p.x + 0.5), 0, nx-1), clamp(i32(p.y + 0.5), 0, ny-1), clamp(i32(p.z + 0.5), 0, nz-1))
			SamplingMode.PER_VERTEX => vertex_index(clamp(i32(p.x), 0, nx), clamp(i32(p.y), 0, ny), clamp(i32(p.z), 0, nz))
			else => 0
	func downsample(_step: i32) -> RegularGrid
		let step = max(_step, 1)
		var r = self
		r.nx = nx / step
		r.ny = ny / step
		r.nz = nz / step
		r.dx = dx * step
		r.dy = dy * step
		r.dz = dz * step
		return r
	func slice(axis: i32, _first: i32, _end: i32, _step: i32) -> RegularGrid
		let n = match axis
			0 => nx
			1 => ny
			else => nz
		let first = clamp(_first, 0, n)
		let end = clamp(_end, first, n)
		let step = max(_step, 1)
		var r = self
		if axis == 0
			r.nx = (end - first + step - 1) / step
			r.dx = dx * step
			r.offset += first * dx
		else if axis == 1
			r.ny = (end - first + step - 1) / step
			r.dy = dy * step
			r.offset += first * dy
		else
			r.nz = (end - first + step - 1) / step
			r.dz = dz * step
			r.offset += first * dz
		return r


struct extern Grid
	var type: GridType
	var regular: RegularGrid?
	func extern __init__()
	func extern vertices() -> vec3[]
	func extern cell_centers() -> vec3[]
	func extern points(mode: SamplingMode) -> vec3[]
	func extern edges() -> (i32,i32)[]
	func extern count(mode: SamplingMode) -> i32
	func extern bounding_box() -> Box

